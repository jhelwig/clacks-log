  "query": "SELECT a.envelope_id, a.kind, a.record_id\nFROM accepted_record a\nJOIN json_each(?2) k ON json_extract(k.value, '$.kind') = a.kind\n AND json_extract(k.value, '$.record_id') = a.record_id\nWHERE a.account = ?1\nORDER BY a.envelope_id DESC\n",
