# Normalize project prose while preserving original reference bytes.
*.md text eol=lf
.gitattributes text eol=lf
references/originals/** -text
references/trustedqsl/upstream/** -text

# Preserve fixtures, generated catalogs and guarded input hashes across checkouts.
lib/**/tests/fixtures/** -text
lib/**/data/*.json -text
references/geography/*.json -text

# SQLx checksums and checked query inputs must not vary across platforms.
*.sql text eol=lf
